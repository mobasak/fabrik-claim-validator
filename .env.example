# fabrik-claim-validator Configuration
# Required
PORT=8002
LOG_LEVEL=INFO

# Database
# WSL dev: postgresql://ozgur@localhost:5432/fabrik_claim_validator_dev
# VPS: set via Coolify secrets POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres-main:5432/fabrik_claim_validator

# Service identity for structured logging
SERVICE_NAME=fabrik-claim-validator

# Sibling service (citation verifier)
CITATION_VERIFIER_URL=http://localhost:8032

# Scraping infrastructure (Sprint 0: stub; Sprint 3: live)
# WSL dev: http://localhost:18011 / http://localhost:18013
# VPS: https://captcha.vps1.ocoron.com / internal proxy service
CAPTCHA_URL=http://localhost:18011
PROXY_URL=http://localhost:18013

# Vision-LLM for PDF table-as-image extraction (FCV-202b; Sprint 4)
# Default routes via OpenRouter to the model specified by KILO_VISION_AGENT_ID.
# Leave OPENROUTER_API_KEY empty in dev/CI — cassette replay is used instead.
KILO_VISION_AGENT_ID=anthropic/claude-opus-4.6
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=anthropic/claude-opus-4.6
