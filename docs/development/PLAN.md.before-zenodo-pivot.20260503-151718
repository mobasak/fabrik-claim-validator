## 4. Schema (full DDL)

```sql
-- ─────────────────────────────────────────────────────────────────
-- 4.1 traditions — first-class registry, peer-equal
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE traditions (
  code                    TEXT PRIMARY KEY,           -- 'western_rct','tcm','kampo','ayush','unani','tpm','rp_xv','ema_hmpc','dong_y','ttm','nhpid','korean'
  name_en                 TEXT NOT NULL,
  name_native             TEXT,
  primary_authority_url   TEXT NOT NULL,
  monograph_corpus_size   INT,                        -- estimated total monographs
  ingestion_status        TEXT NOT NULL,              -- 'pending'|'partial'|'complete'|'data_acquisition_pending'
  evidence_weight_class   TEXT NOT NULL,              -- 'regulatory_pharmacopoeia'|'academic_consensus'|'clinical_research'|'ethnobotanical_record'
  primary_lang            TEXT NOT NULL,              -- ISO 639-1
  parent_tradition_id     TEXT REFERENCES traditions(code),  -- TCM<-Kampo, TCM<-Đông y, Persian<-Unani-Tibb
  independence_weight     REAL NOT NULL DEFAULT 1.0,  -- 1.0 for parent, 0.4 for child (configurable)
  evidence_tier_map       JSONB NOT NULL,             -- per-tradition tier scale; see §5.3
  last_indexed_at         TIMESTAMPTZ,
  created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX traditions_parent_idx ON traditions(parent_tradition_id);

-- ─────────────────────────────────────────────────────────────────
-- 4.2 compounds — PubChem-rooted compound identity
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE compounds (
  pubchem_cid             BIGINT PRIMARY KEY,
  canonical_name          TEXT NOT NULL,
  iupac_name              TEXT,
  inchi                   TEXT,
  inchi_key               TEXT UNIQUE,
  smiles                  TEXT,
  molecular_formula       TEXT,
  molecular_weight        REAL,
  cas_number              TEXT,
  is_botanical            BOOLEAN NOT NULL DEFAULT FALSE,
  taxon_canonical         TEXT,                       -- e.g. 'Panax ginseng C.A. Meyer'
  wfo_id                  TEXT,                       -- World Flora Online ID for botanicals
  fetched_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX compounds_inchi_key_idx ON compounds(inchi_key);
CREATE INDEX compounds_taxon_idx ON compounds(taxon_canonical);

-- ─────────────────────────────────────────────────────────────────
-- 4.3 taxa_aliases — same plant, multiple names across traditions
-- Seeded from WHO ICTM (ICD-11 Ch.26 / TM2) + World Flora Online
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE taxa_aliases (
  id                      BIGSERIAL PRIMARY KEY,
  pubchem_cid             BIGINT REFERENCES compounds(pubchem_cid),
  alias_name              TEXT NOT NULL,
  alias_lang              TEXT NOT NULL,              -- ISO 639-1
  alias_script            TEXT,                       -- 'Latn','Hans','Hant','Kana','Hang','Cyrl','Arab','Deva','Thai'
  tradition_code          TEXT REFERENCES traditions(code),
  alias_type              TEXT NOT NULL,              -- 'common'|'pharmacopoeial'|'pinyin'|'romanized'|'scientific_synonym'|'legacy'
  source                  TEXT NOT NULL,              -- 'who_ictm'|'wfo'|'manual'|'<scraper_id>'
  source_record_id        TEXT,
  created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE UNIQUE INDEX taxa_aliases_uniq ON taxa_aliases(pubchem_cid, alias_name, alias_lang, tradition_code);
CREATE INDEX taxa_aliases_alias_lower ON taxa_aliases(LOWER(alias_name));

-- ─────────────────────────────────────────────────────────────────
-- 4.4 monographs — per-tradition monograph entries
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE monographs (
  id                      BIGSERIAL PRIMARY KEY,
  tradition_code          TEXT NOT NULL REFERENCES traditions(code),
  source_id               TEXT NOT NULL,              -- e.g. 'chinese_pharmacopoeia_2020'
  monograph_native_id     TEXT NOT NULL,              -- e.g. PMDA monograph code, EMA HMPC slug
  pubchem_cid             BIGINT REFERENCES compounds(pubchem_cid),  -- nullable if compound resolution failed
  taxon_canonical         TEXT,                       -- joined via taxa_aliases when CID unknown
  title_native            TEXT,
  title_en                TEXT,
  monograph_lang          TEXT NOT NULL,
  monograph_script        TEXT,
  evidence_tier           TEXT NOT NULL,              -- per-tradition tier code (A/B/C or tradition-specific)
  indications_native      TEXT[],
  indications_normalized  TEXT[],                     -- mapped to ICD-11 / ICTM TM2 / canonical strings
  preparations            JSONB,                      -- {form:'decoction',dose_range:'3-9g/day',...}
  contraindications_native TEXT[],
  contraindications_normalized TEXT[],
  full_text               TEXT,                       -- monograph body (verbatim native + machine_translation)
  full_text_translation   TEXT,                       -- separate column when machine-translated
  source_url              TEXT,
  page_refs               JSONB,                      -- {pdf_page_start:412, pdf_page_end:415}
  scraped_at              TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  cassette_id             TEXT,                       -- recorded fixture for offline CI
  raw_response_hash       TEXT                        -- sha256 of upstream payload for de-dup
);
CREATE INDEX monographs_tradition_idx ON monographs(tradition_code);
CREATE INDEX monographs_pubchem_idx ON monographs(pubchem_cid);
CREATE INDEX monographs_indications_gin ON monographs USING GIN (indications_normalized);
CREATE UNIQUE INDEX monographs_native_uniq ON monographs(tradition_code, source_id, monograph_native_id);

-- ─────────────────────────────────────────────────────────────────
-- 4.5 claims — (substance, indication) atoms; canonical claim shape
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE claims (
  id                      BIGSERIAL PRIMARY KEY,
  claim_hash              TEXT UNIQUE NOT NULL,       -- sha256(pubchem_cid || indication_code || mechanism || endpoint)
  pubchem_cid             BIGINT REFERENCES compounds(pubchem_cid),
  taxon_canonical         TEXT,                       -- when no CID
  indication_code         TEXT NOT NULL,              -- ICD-11 / ICTM TM2 / canonical
  mechanism               TEXT,                       -- 'antioxidant', 'monoamine_modulation', etc. (free-form lookup)
  endpoint                TEXT,                       -- 'fatigue_score','HbA1c','vital_capacity'
  dose_range              JSONB,                      -- {min:200, max:2000, unit:'mg/day', form:'standardized_extract'}
  population              JSONB,                      -- {age_range, condition, sex_restriction}
  created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX claims_pubchem_idx ON claims(pubchem_cid);
CREATE INDEX claims_indication_idx ON claims(indication_code);

-- ─────────────────────────────────────────────────────────────────
-- 4.6 claim_evidence — links claims to monographs / RCTs / regulatory entries
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE claim_evidence (
  id                      BIGSERIAL PRIMARY KEY,
  claim_id                BIGINT NOT NULL REFERENCES claims(id) ON DELETE CASCADE,
  tradition_code          TEXT NOT NULL REFERENCES traditions(code),
  evidence_type           TEXT NOT NULL,              -- 'monograph'|'rct'|'meta_analysis'|'regulatory_assessment'|'case_series'|'in_vitro'|'animal'
  evidence_id             BIGINT,                     -- monograph.id when monograph
  external_id             TEXT,                       -- PMID / DOI / ClinicalTrials NCT for non-monograph
  verifier_response       JSONB,                      -- cached fabrik-citation-verifier response (Tier A/B/C, snippet, retraction flag)
  evidence_quality        TEXT NOT NULL,              -- 'A'|'B'|'C' (tradition-mapped via traditions.evidence_tier_map)
  direction               TEXT NOT NULL,              -- 'supports'|'contradicts'|'mixed'|'contextual'|'silent'
  effect_size             JSONB,                      -- {metric:'cohen_d',value:0.32,ci_low:0.10,ci_high:0.54} or null
  notes                   TEXT,
  created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX claim_evidence_claim_idx ON claim_evidence(claim_id);
CREATE INDEX claim_evidence_tradition_idx ON claim_evidence(tradition_code);

-- ─────────────────────────────────────────────────────────────────
-- 4.7 cache_entries — persistent cache layer (90d TTL, monograph data)
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE cache_entries (
  cache_key               TEXT PRIMARY KEY,           -- sha256(scraper_id || query)
  scraper_id              TEXT NOT NULL,              -- e.g. 'ema_hmpc.search', 'ayush.detail'
  query_payload           JSONB NOT NULL,
  response_payload        JSONB NOT NULL,
  upstream_etag           TEXT,
  fetched_at              TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  expires_at              TIMESTAMPTZ NOT NULL,        -- fetched_at + 90d
  hit_count               INT NOT NULL DEFAULT 0
);
CREATE INDEX cache_entries_scraper_idx ON cache_entries(scraper_id);
CREATE INDEX cache_entries_expires_idx ON cache_entries(expires_at);

-- ─────────────────────────────────────────────────────────────────
-- 4.8 discovery_cache — short TTL because new ingest changes the answer
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE discovery_cache (
  cache_key               TEXT PRIMARY KEY,           -- sha256(indication || min_traditions || independence_weighting || evidence_quality_floor)
  indication              TEXT NOT NULL,
  request_payload         JSONB NOT NULL,
  response_payload        JSONB NOT NULL,
  computed_at             TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  expires_at              TIMESTAMPTZ NOT NULL,        -- computed_at + 24h
  invalidated_by_ingest   BOOLEAN NOT NULL DEFAULT FALSE  -- set true when new monograph for this indication arrives
);
CREATE INDEX discovery_cache_indication_idx ON discovery_cache(indication);
CREATE INDEX discovery_cache_expires_idx ON discovery_cache(expires_at);

-- ─────────────────────────────────────────────────────────────────
-- 4.9 proxy_budget — track GB / day across all scrapers
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE proxy_budget (
  bucket_date             DATE PRIMARY KEY,
  bytes_consumed          BIGINT NOT NULL DEFAULT 0,
  bytes_budget            BIGINT NOT NULL,            -- monthly_budget / days_in_month
  request_count           BIGINT NOT NULL DEFAULT 0,
  hard_stopped_at         TIMESTAMPTZ                 -- non-null = freeze active
);

-- ─────────────────────────────────────────────────────────────────
-- 4.10 ingest_log — per-tradition fetch volume for rate-burn detection
-- ─────────────────────────────────────────────────────────────────
CREATE TABLE ingest_log (
  id                      BIGSERIAL PRIMARY KEY,
  tradition_code          TEXT NOT NULL REFERENCES traditions(code),
  scraper_id              TEXT NOT NULL,
  worker_id               INT,
  proxy_used              TEXT,
  request_url             TEXT,
  http_status             INT,
  bytes_received          BIGINT,
  elapsed_ms              INT,
  captcha_solved          BOOLEAN NOT NULL DEFAULT FALSE,
  captcha_cost_ms         INT,
  error_class             TEXT,                        -- 'timeout','blocked','captcha_unsolvable','parse_error'
  cassette_id             TEXT,
  occurred_at             TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE INDEX ingest_log_tradition_time ON ingest_log(tradition_code, occurred_at DESC);
```

**Why this shape, not a simpler one:**
- `claim_hash` lets us deduplicate (substance, indication, mechanism, endpoint) atoms across multiple monographs that say "the same thing"
- `claim_evidence.direction` is enum — `supports/contradicts/mixed/contextual/silent` — which is the database-level enforcement of tri-state aggregation; the aggregator can't accidentally collapse these
- `claim_evidence.evidence_quality` is a per-tradition letter grade; the aggregator looks it up via `traditions.evidence_tier_map` so each tradition is graded by its own scale
- `monographs.indications_normalized` is a `TEXT[]` with GIN index — fast `WHERE indications_normalized && ARRAY[...]` queries for the discovery engine
- `traditions.parent_tradition_id` + `traditions.independence_weight` makes independence weighting a SQL join, not a hardcoded constant in Python
- `cache_entries` and `discovery_cache` are separate tables because monograph data is stable for 90d, but discovery results invalidate as soon as new monographs arrive


