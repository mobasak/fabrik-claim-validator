[Unit]
Description=Fabrik Claim Validator (multi-tradition claim + discovery service)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ozgur
Group=ozgur
WorkingDirectory=/opt/fabrik-claim-validator
EnvironmentFile=-/opt/fabrik-claim-validator/.env.local
EnvironmentFile=-/opt/fabrik-claim-validator/.env
ExecStart=/opt/fabrik-claim-validator/.venv/bin/uvicorn fabrik_claim_validator.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (mild; we still need /opt and Postgres socket).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
