    "text": "<!DOCTYPE html>\n<!--[if gt IE 8]><!-->\n<!--[if lt IE 9]><html class=\"no-js lt-ie9\" dir=\"ltr\"><![endif]-->\n<html xmlns=\"http://www.w3.org/1999/xhtml\" class=\"no-js\" lang=\"en\" dir=\"ltr\" xmlns:sec=\"http://www.thymeleaf.org/thymeleaf-extras-springsecurity3\">\r\n<!--<![endif]-->\r\n  <head>\r\n    <meta charset=\"utf-8\" />\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n    <!-- Web Experience Toolkit (WET) / Boîte à outils de l'expérience Web (BOEW)\r\n         wet-boew.github.io/wet-boew/License-en.html / wet-boew.github.io/wet-boew/Licence-fr.html -->\r\n    \n    <title>Temporary title</title>\r\n    <meta content=\"width=device-width,initial-scale=1\" name=\"viewport\" />\r\n    <!-- Additional analytics, if required. -->\r\n     <!-- Add analytics here -->\n \r\n    <!-- Load closure template scripts -->\r\n    <script type=\"text/javascript\" src=\"https://www.canada.ca/etc/designs/canada/cdts/gcweb/v4_0_47/cdts/compiled/soyutils.js\"></script>\r\n    <script type=\"text/javascript\" src=\"https://www.canada.ca/etc/designs/canada/cdts/gcweb/v4_0_47/cdts/compiled/wet-en.js\"></script>\r\n    <noscript>\r\n      <!-- Write closure fall-back static file -->\r\n      \n      <!-- Close the tag in the template -->\n      </noscript>\n      <link href=\"/nhpid-bdipsn/css/main.css\" rel=\"stylesheet\" />\n      <script src=\"/nhpid-bdipsn/webjars/jquery/3.5.1/jquery.min.js\"></script>\n      <script src=\"/nhpid-bdipsn/webjars/bootstrap/5.1.3/js/bootstrap.min.js\"></script>\n      <script src=\"/nhpid-bdipsn/js/app.js\"></script>\n      <script>\n  \t\t$( document ).ready(function() {\n  \t\t\t// Set page title as the same as h1 text\n  \t\t\tvar header = $('h1').html();\n  \t\t\tif (header != undefined) {\n  \t\t\t\tvar regX = /(<([^>]+)>)/ig;\n  \t\t\t\t$('title').html(header.replace(regX, \"\"));\n  \t\t\t}\n  \t\t});\n  \t\t</script><!--[if gte IE 9 | !IE ]><!-->\r\n\r\n<link\r\n\thref=\"https://www.canada.ca/etc/de